# =========================================================
# inventory-its — .gitignore
# =========================================================

# ---- Segredos / ambiente ----
.env
.env.local
.env.*.local

# ---- Backups do banco (não versionar dumps) ----
backups/*.sql.gz
backups/*.sql
backups/backup.log

# ---- Dependências ----
node_modules/
**/node_modules/

# ---- Builds ----
dist/
build/
.next/
out/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Expo / React Native (app mobile) ----
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ---- Editor / SO ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Docker ----
*.pid
