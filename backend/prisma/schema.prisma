// =========================================================
// inventory-its — Prisma schema
//
// Este arquivo é a ÚNICA fonte de verdade do schema. Pra criar as
// tabelas no banco, normalmente roda `npm run prisma:push`
// (executa `prisma db push`) — MAS esse comando precisa baixar um
// binário de `binaries.prisma.sh` na primeira vez, e isso fica
// bloqueado em rede corporativa restritiva (confirmado — ver
// DEPLOY.md). Pra esse caso, `backend/prisma/schema.sql` tem o
// mesmo schema em SQL puro, aplicável via `psql` direto (só fala
// com o Postgres, nenhuma chamada externa). Se o schema.prisma
// mudar, schema.sql precisa ser atualizado junto.
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  admin
  cadastrador
  operador
}

enum Situacao {
  bom
  ruim
}

model Usuario {
  id           BigInt   @id @default(autoincrement())
  nome         String   @db.VarChar(150)
  // Nome de usuário pra login, alternativo ao email (ver
  // auth.controller.js: login aceita um OU o outro). Nullable só pra
  // não travar a migração de contas já existentes sem esse campo —
  // scripts/preencher-usuario-login.js faz o backfill a partir do
  // email; toda conta nova é obrigada a ter (ver usuarios.controller.js).
  usuario      String?  @unique @db.VarChar(60)
  email        String   @unique @db.VarChar(190)
  senhaHash    String   @map("senha_hash") @db.VarChar(255)
  papel        Papel    @default(operador)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  dispositivos    Dispositivo[]
  itensCriados    Item[]               @relation("ItemCriadoPor")
  eventos         EventoMovimentacao[]
  lotesEtiquetas  LoteEtiquetas[]

  @@map("usuarios")
}

model Dispositivo {
  id                    BigInt    @id @default(autoincrement())
  usuarioId             BigInt    @map("usuario_id")
  identificador         String    @unique @db.VarChar(190)
  apelido               String?   @db.VarChar(100)
  ultimaSincronizacaoEm DateTime? @map("ultima_sincronizacao_em")
  criadoEm              DateTime  @default(now()) @map("criado_em")

  usuario  Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  eventos  EventoMovimentacao[]

  @@map("dispositivos")
}

model Setor {
  id        BigInt   @id @default(autoincrement())
  nome      String   @unique @db.VarChar(150)
  descricao String?  @db.VarChar(255)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  itensAtuais      Item[]               @relation("ItemSetorAtual")
  eventosAnteriores EventoMovimentacao[] @relation("SetorAnterior")
  eventosNovos      EventoMovimentacao[] @relation("SetorNovo")

  @@map("setores")
}

model Item {
  id                BigInt    @id @default(autoincrement())
  // Nulo até o item ganhar um código de verdade: na hora de cadastrar
  // (se já tem etiqueta de patrimônio física) ou na hora de entrar
  // num lote de impressão (se não tem — o código só é gerado nesse
  // momento, pra nunca existir código no sistema sem existir etiqueta
  // física correspondente — ver conversa com o João).
  // NÃO é @unique de propósito (era antes — ver histórico): uma
  // etiqueta de patrimônio física pode estar colada em mais de um bem
  // por engano (ver levantamento patrimonial de 2026), e nesse caso
  // dois itens DIFERENTES têm o mesmo "codigo" de verdade — sem
  // inventar sufixo tipo "-A"/"-B", que fazia o código de barras
  // bipado não bater com o item achado (ver conversa com o João).
  // "patrimonioDuplicado" sinaliza esse caso visualmente, e
  // buscarPorCodigo() já devolve os vários itens pra quem bipou
  // escolher o certo.
  codigo            String?   @db.VarChar(30)
  descricao         String    @db.VarChar(255)
  categoria         String?   @db.VarChar(100)

  // Número bruto lido do código de barras da etiqueta de patrimônio
  // física (ex.: "9637"). Sempre igual ao "codigo" quando o item tem
  // etiqueta física (os dois só divergem pra item sem etiqueta nenhuma,
  // que nasce com codigo=null até ganhar um número gerado pelo sistema
  // — ver codigoGerado.js). Mantido como campo à parte porque é o
  // valor "bruto" físico, útil pra busca/depuração mesmo se "codigo"
  // um dia precisar de alguma transformação.
  numeroEtiqueta       String?   @map("numero_etiqueta") @db.VarChar(30)
  // true quando numeroEtiqueta é compartilhado por mais de um item —
  // sinaliza no painel que esse bem física precisa ser re-etiquetado.
  patrimonioDuplicado  Boolean   @default(false) @map("patrimonio_duplicado")

  setorAtualId      BigInt?   @map("setor_atual_id")
  situacaoAtual     Situacao  @default(bom) @map("situacao_atual")

  etiquetaImpressa  Boolean   @default(false) @map("etiqueta_impressa")
  loteEtiquetaId    BigInt?   @map("lote_etiqueta_id")

  criadoPor         BigInt?   @map("criado_por")
  criadoEm          DateTime  @default(now()) @map("criado_em")
  atualizadoEm      DateTime  @default(now()) @updatedAt @map("atualizado_em")

  setorAtual        Setor?               @relation("ItemSetorAtual", fields: [setorAtualId], references: [id])
  criadoPorUsuario  Usuario?             @relation("ItemCriadoPor", fields: [criadoPor], references: [id])
  eventos           EventoMovimentacao[]
  lotes             LoteEtiquetasItem[]

  @@map("itens")
  @@index([setorAtualId])
  @@index([etiquetaImpressa])
  @@index([numeroEtiqueta])
  // codigo perdeu o @unique (duplicidade física é permitida agora),
  // mas continua sendo a busca mais comum do sistema — precisa do
  // índice à parte, já que não ganha mais um automático.
  @@index([codigo])
}

model EventoMovimentacao {
  id                    BigInt   @id @default(autoincrement())
  itemId                BigInt   @map("item_id")
  usuarioId             BigInt   @map("usuario_id")
  dispositivoId         BigInt?  @map("dispositivo_id")

  setorAnteriorId       BigInt?  @map("setor_anterior_id")
  setorNovoId           BigInt?  @map("setor_novo_id")
  situacaoAnterior      String?  @map("situacao_anterior") @db.VarChar(30)
  situacaoNova          String?  @map("situacao_nova") @db.VarChar(30)

  observacao            String?  @db.VarChar(255)

  uuidEvento            String   @unique @map("uuid_evento") @db.Char(36)

  timestampEvento       DateTime @map("timestamp_evento")
  timestampSincronizado DateTime @default(now()) @map("timestamp_sincronizado")

  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  dispositivo    Dispositivo? @relation(fields: [dispositivoId], references: [id])
  setorAnterior  Setor?       @relation("SetorAnterior", fields: [setorAnteriorId], references: [id])
  setorNovo      Setor?       @relation("SetorNovo", fields: [setorNovoId], references: [id])

  @@map("eventos_movimentacao")
  @@index([itemId, timestampEvento])
  @@index([usuarioId])
}

model LoteEtiquetas {
  id               BigInt   @id @default(autoincrement())
  usuarioId        BigInt   @map("usuario_id")
  quantidadeItens  Int      @default(0) @map("quantidade_itens")
  observacao       String?  @db.VarChar(255)
  criadoEm         DateTime @default(now()) @map("criado_em")

  usuario Usuario             @relation(fields: [usuarioId], references: [id])
  itens   LoteEtiquetasItem[]

  @@map("lotes_etiquetas")
}

model LoteEtiquetasItem {
  loteId BigInt @map("lote_id")
  itemId BigInt @map("item_id")

  lote LoteEtiquetas @relation(fields: [loteId], references: [id], onDelete: Cascade)
  item Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([loteId, itemId])
  @@map("lote_etiquetas_itens")
}

enum NivelLog {
  sucesso
  erro
  aviso
  info
}

enum OrigemLog {
  web
  app
  backend
}

// Registro de eventos do sistema (sucesso E erro), vindos do painel
// web, do app mobile e do próprio backend — pensado pra dar aos
// administradores uma visão de "o que está acontecendo" sem precisar
// abrir console/logs de servidor (ver tela de Monitoramento no
// painel web). Toda ação sensível (login, cadastro/edição/exclusão
// de item, usuário, setor, lote, sincronização do app) grava uma
// linha aqui, além de QUALQUER exceção não tratada ser capturada
// automaticamente pelo errorHandler.
//
// "usuarioId" NÃO é uma foreign key de propósito (igual
// Item.loteEtiquetaId): um log precisa sobreviver à exclusão do
// usuário que o gerou (auditoria), então guardamos também
// "usuarioNome" como uma cópia ("snapshot") do nome na hora do
// evento — continua legível mesmo que o usuário seja excluído depois.
model LogSistema {
  id          BigInt    @id @default(autoincrement())
  nivel       NivelLog
  origem      OrigemLog
  // Identificador curto da ação, ex: "login", "criar_item",
  // "excluir_usuario", "sincronizar_eventos" — usado pra filtrar/
  // agrupar na tela de monitoramento.
  acao        String    @db.VarChar(100)
  mensagem    String    @db.VarChar(500)
  // Detalhe extra opcional: stack trace de erro, JSON de contexto, etc.
  // Guardado como texto livre — não é pensado pra ser consultado,
  // só exibido quando o admin expande a linha.
  detalhes    String?
  usuarioId   BigInt?   @map("usuario_id")
  usuarioNome String?   @map("usuario_nome") @db.VarChar(150)
  // Rota/tela de origem (ex: "POST /api/itens", "app:ItemFormScreen"),
  // só pra contexto — não é obrigatório.
  rota        String?   @db.VarChar(255)
  criadoEm    DateTime  @default(now()) @map("criado_em")

  @@map("logs_sistema")
  @@index([nivel])
  @@index([origem])
  @@index([criadoEm])
  @@index([usuarioId])
}
