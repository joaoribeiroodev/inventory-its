# Para rodar o backend sozinho, fora do Docker (ex: npm run dev),
# copie para .env e ajuste.
#
# Se o Postgres estiver rodando no Docker (ver docker-compose.yml na
# raiz do projeto), aponte pra porta publicada dele no host, ex:
# postgresql://inventory_its:SENHA@localhost:5432/inventory_its
#
# Se preferir um Postgres gerenciado (Neon, etc.), use a connection
# string de lá — o formato é o mesmo.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/inventory_its"
PORT=3001
JWT_SECRET=troque_este_segredo_aleatorio_longo
JWT_EXPIRES_IN=30d
