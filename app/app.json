{
  "expo": {
    "name": "inventory-its",
    "slug": "inventory-its",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "backgroundColor": "#0B3B60",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B3B60"
    },
    "extra": {
      "defaultServerUrl": "https://inventory-its.onrender.com",
      "eas": {
        "projectId": "6b29f1c1-0c2c-4ba1-9278-e0af6becef2b"
      }
    },
    "android": {
      "package": "br.com.internacionaltravessias.inventoryits",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0B3B60"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "O app precisa da câmera para ler o QR Code das etiquetas."
        }
      ],
      "expo-font"
    ]
  }
}
