# =========================================================
# inventory-its — variáveis de ambiente (setup self-hosted)
#
# Copie este arquivo para ".env" na raiz do projeto e ajuste os
# valores pro seu servidor antes de rodar "docker compose up".
# NUNCA versionar o ".env" real (já está no .gitignore) — ele vai
# ter a senha do banco e o segredo do JWT.
#
# Ver DEPLOY.md pro passo a passo completo de instalação.
# =========================================================

# ---- Banco de dados (Postgres rodando no próprio Docker) ----
# Usuário/senha/nome do banco que o container "postgres" cria na
# primeira vez que sobe (ver docker-compose.yml) — o backend monta
# a DATABASE_URL sozinho a partir dessas três variáveis, não precisa
# escrever a connection string na mão.
POSTGRES_USER=inventory_its
POSTGRES_PASSWORD=troque-esta-senha-tambem
POSTGRES_DB=inventory_its

# ---- Backend (API) ----
API_PORT=3001
JWT_SECRET=troque_este_segredo_aleatorio_longo
JWT_EXPIRES_IN=30d

# Credenciais do primeiro usuário admin (usadas por "npm run seed")
SEED_ADMIN_EMAIL=admin@its.local
SEED_ADMIN_USUARIO=admin
SEED_ADMIN_SENHA=mude-esta-senha
SEED_ADMIN_NOME=Administrador

# ---- Painel Web (Next.js) ----
WEB_PORT=3000
# O IP (fixo) do servidor dentro da rede da empresa, seguido da
# porta do backend. É o endereço que o NAVEGADOR de quem acessa o
# painel vai usar pra falar com a API — não pode ser "localhost" nem
# o nome do container, porque quem abre o painel está em outro PC da
# rede. Troque pelo IP real do servidor (ex: http://192.168.1.50:3001).
NEXT_PUBLIC_API_URL=http://SEU_IP_AQUI:3001
