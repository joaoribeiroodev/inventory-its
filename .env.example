# =========================================================
# inventory-its — variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores antes de
# rodar localmente. NUNCA versionar o ".env" real (já está no
# .gitignore). Em produção, essas variáveis são configuradas
# direto nos painéis do Render e da Vercel — não usam este arquivo.
# =========================================================

# ---- Banco de dados (PostgreSQL, hospedado no Neon — neon.tech) ----
# Pegue essa string em Neon > seu projeto > Connection string.
# Formato: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/inventory_its?sslmode=require

# ---- Backend (API) ----
API_PORT=3001
JWT_SECRET=troque_este_segredo_aleatorio_longo
JWT_EXPIRES_IN=30d

# Credenciais do primeiro usuário admin (usadas por "npm run seed")
SEED_ADMIN_EMAIL=admin@its.local
SEED_ADMIN_SENHA=mude-esta-senha
SEED_ADMIN_NOME=Administrador

# ---- Painel Web (Next.js) ----
WEB_PORT=3000
# Em desenvolvimento local: http://localhost:3001
# Em produção: a URL pública do backend no Render, sem /api no
# final (o painel já adiciona /api sozinho) — ex:
# https://inventory-its-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3001
